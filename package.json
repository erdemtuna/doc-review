{
  "name": "@erdemtuna/doc-review",
  "version": "0.10.0",
  "description": "Review and edit agent-generated files and localhost pages in the browser, then send the whole batch back to your agent.",
  "author": "Peter Yang",
  "homepage": "https://github.com/erdemtuna/doc-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erdemtuna/doc-review.git"
  },
  "bugs": {
    "url": "https://github.com/erdemtuna/doc-review/issues"
  },
  "type": "module",
  "bin": {
    "doc-review": "lib/cli.js"
  },
  "files": [
    "lib",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.21.0"
  },
  "packageManager": "npm@12.0.2",
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc -p tsconfig.shared.json && tsc -p tsconfig.browser.json && tsc -p tsconfig.node.json && tsc -p tsconfig.ui.json && tsc -p tsconfig.ui-test.json && tsc -p tsconfig.tooling.json",
    "prepack": "node scripts/build.js",
    "test": "npm run test:unit",
    "test:unit": "npm run build && node --test test/*.test.js && npm run test:ui",
    "test:ui": "vitest run",
    "preview:ui": "node scripts/ui-preview.js",
    "preview:recovery": "node scripts/ui-preview.js --recovery",
    "preview:shell": "npm run build && node scripts/shell-preview.js",
    "preview:review": "npm run build && node scripts/migration-review.js",
    "media:readme": "npm run build && node scripts/capture-readme.js",
    "media:preview": "node scripts/preview-readme.js",
    "test:browser": "npm run build && playwright test",
    "test:package": "node scripts/package-smoke.js",
    "test:package:browser": "node scripts/package-smoke.js --browser",
    "test:all": "npm run build && node --test test/*.test.js && npm run test:ui && playwright test && npm run test:package",
    "browser:install": "playwright install chromium",
    "browser:install:ci": "playwright install --with-deps chromium",
    "start": "npm run build && node lib/cli.js"
  },
  "keywords": [
    "html",
    "markdown",
    "localhost",
    "nextjs",
    "review",
    "comments",
    "agent",
    "claude-code",
    "codex",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.10.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "jsdom": "30.0.1",
    "lucide-static": "1.44.0",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  },
  "dependencies": {
    "diff": "9.0.0",
    "marked": "18.0.12",
    "parse5": "8.0.1"
  }
}
