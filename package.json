{
  "name": "@erdemtuna/doc-review",
  "version": "0.8.0",
  "description": "Review and edit agent-generated files and localhost pages in the browser, then send the whole batch back to your agent.",
  "author": "Peter Yang",
  "homepage": "https://github.com/erdemtuna/doc-review#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/erdemtuna/doc-review.git"
  },
  "bugs": {
    "url": "https://github.com/erdemtuna/doc-review/issues"
  },
  "type": "module",
  "bin": {
    "doc-review": "src/cli.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run test:unit",
    "test:unit": "node --test",
    "test:browser": "playwright test",
    "test:all": "npm run test:unit && npm run test:browser",
    "start": "node src/cli.js"
  },
  "keywords": [
    "html",
    "markdown",
    "localhost",
    "nextjs",
    "review",
    "comments",
    "agent",
    "claude-code",
    "codex",
    "cli"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "jsdom": "^29.1.1",
    "lucide-static": "^1.34.0"
  },
  "dependencies": {
    "marked": "^18.0.7"
  }
}
